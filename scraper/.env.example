# Copy to scraper/.env and fill in. The scraper's start script loads it with
# --env-file-if-exists, so a missing file is not an error.

# Crawlee log verbosity: DEBUG | INFO | WARNING | ERROR | OFF
CRAWLEE_LOG_LEVEL=INFO

# Where each audit is saved. Without both, the run prints one line and carries on.
# The key is a secret key (sb_secret_…) or a legacy service_role key — never the
# publishable key, which RLS shuts out of every table.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-key-here
